# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# ---- Domain / TLS ----
DOMAIN=vpn.example.com
ACME_EMAIL=you@example.com
# Host clients use for the IKEv2 tunnel itself. Set this to the server's
# raw public IP — more reliable than a domain (esp. sslip.io) on mobile
# networks whose DNS may not resolve it. Leave blank to fall back to DOMAIN.
# Also embedded in the server cert's CN/SAN — changing it after first boot
# means re-issuing the server cert (delete the ipsec-data volume, or issue
# a fresh one manually).
IPSEC_ENDPOINT_HOST=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=changeme
# Comma-separated Telegram numeric user IDs that get the admin role.
TELEGRAM_ADMIN_IDS=123456789

# ---- Backend ----
# Max active devices (peers) a non-admin user may register at once.
MAX_DEVICES_PER_USER=5

# ---- Postgres ----
POSTGRES_DB=vpnbot
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=changeme-generate-a-long-random-value

# ---- IKEv2/IPsec (Libreswan) ----
# UDP 500 (IKE) + 4500 (NAT-T) — unrelated to Caddy's 80/443, no port
# sharing needed. IPSEC_NETWORK/POOL_START/POOL_END is the private subnet
# IKEv2 clients get assigned an address from.
IPSEC_NETWORK=192.168.44.0/24
IPSEC_POOL_START=192.168.44.10
IPSEC_POOL_END=192.168.44.250
IPSEC_DNS=1.1.1.1,8.8.8.8
# Host's public network interface, used for NAT masquerade (check with `ip route`).
IPSEC_EXTERNAL_IF=eth0
