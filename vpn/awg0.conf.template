[Interface]
PrivateKey = ${AWG_SERVER_PRIVATE_KEY}
Address = ${AWG_ADDRESS}
ListenPort = ${AWG_PORT}
MTU = ${AWG_MTU}
PostUp = iptables -I FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -o ${AWG_EXTERNAL_IF} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -o ${AWG_EXTERNAL_IF} -j MASQUERADE
Jc = ${AWG_JC}
Jmin = ${AWG_JMIN}
Jmax = ${AWG_JMAX}
S1 = ${AWG_S1}
S2 = ${AWG_S2}
S3 = ${AWG_S3}
S4 = ${AWG_S4}
H1 = ${AWG_H1}
H2 = ${AWG_H2}
H3 = ${AWG_H3}
H4 = ${AWG_H4}

# No [Peer] sections here on purpose: peers are added/removed at runtime by
# the backend via `awg set`, keyed off Postgres, never baked into this file.
